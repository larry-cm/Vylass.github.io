---
import { SocialMedia } from "@/components/Buttons";
import type { ExternalAccount, SocialLinks } from "@/types/type";
const formatDate = (date: Date) =>
  date.toLocaleTimeString(Astro.locals.lang, {
    timeZone: "UTC",
    year: "numeric",
    day: "2-digit",
    hour: "numeric",
  });
interface Props {
  userUrl: string;
  userName: string;
  postDate: string;
  title: string;
  content: string;
  mediaLinks: SocialLinks;
}
const { userName, userUrl, postDate, title, content, mediaLinks } = Astro.props;
---

<article
  class="flex flex-col gap-4 lg:max-w-xs min-w-xs lg:basis-1/3"
  aria-label="información respectiva del usuario"
>
  <a
    href="/comunidad"
    class="block w-full px-4 py-2 text-lg font-medium text-center rounded min-w-28 sm:text-start bg-secondary"
    >Volver
  </a>

  <div class="flex flex-col h-full gap-4 sm:flex-row lg:flex-col">
    <div
      class="p-4 rounded-md bg-fondo space-y-[.5lh] min-w-fit w-full shadow-md"
    >
      <header class="flex flex-row items-start gap-5">
        <img
          class="rounded size-24"
          src={userUrl || "/logo.svg"}
          alt={`foto del perfil del usuario `}
        />

        <SocialMedia client:visible mediaLinks={mediaLinks} />
      </header>

      <h3 class="line-clamp-2">
        <b class="inline font-medium">Creador :</b>
        <span>{userName || "no tiene usuario"}</span>
      </h3>

      <p class="line-clamp-2">
        <b class="font-medium">Publicado :</b>
        <span>{formatDate(new Date(postDate)) || formatDate(new Date())}</span>
      </p>
    </div>

    <div
      class="p-4 line-clamp-3 text-break rounded-md bg-fondo space-y-[.5lh] h-auto w-full lg:h-full shadow-md"
    >
      <h3 class="font-medium">
        {title || "Titulo de la publicación"}
      </h3>
      <p class="">
        {
          content ||
            " Lorem ipsum dolor sit amet consectetur adipisicing elit. Iusto debitis culpa quas fugiat error. Vel recusandae fugit similique quis consequatur aliquid, accusamus quasi earum quaerat iure dolore dignissimos ullam"
        }
      </p>
    </div>
  </div>
</article>
