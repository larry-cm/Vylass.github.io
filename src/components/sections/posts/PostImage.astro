        Descargar
      </a>
    </ButtonMenu> -->
  </div>
</article>

<style>
  .escalando {
    transform: scale(0);
    animation: scaleAni 0.3s ease 1 both;
  }
  .escaleDown {
    transform: scale(1);
    animation: scaleAniReverse 0.3s ease 1 both;
  }
  @starting-style {
    .escalando {
      transform: scale(0);
    }
    .escaleDown {
      transform: scale(1);
    }
  }
  @keyframes scaleAni {
    to {
      transform: scale(1);
    }
  }
  @keyframes scaleAniReverse {
    to {
      transform: scale(0);
    }
  }
</style>
