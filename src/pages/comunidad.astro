---
import Layout from "@/layouts/Layout.astro";
import { turso } from "@/utils/configTurso";

import PostRecientes from "@/components/sections/community/PostRecientes.astro";
import FormPost from "@/components/sections/community/FormPost";
import Aviso from "@/components/sections/community/Aviso.astro";
import MisProyectos from "@components/sections/community/MisProyectos.astro";

const { redirectToSignIn } = Astro.locals.auth();
const user = await Astro.locals.currentUser();
if (!user) return redirectToSignIn();

const { firstName, lastName, id, hasImage, imageUrl, primaryEmailAddress } =
    user;

const result = await turso.execute(`
      SELECT
        user_name,
        u.user_id,
        user_url,
        post_title,
        post_content,
        post_url,
        post_date,
        post_id
      FROM
        post p,
        users u
      WHERE
        u.user_id = p.user_id
      ORDER BY
        p.post_id DESC
      LIMIT
        10
      `);
const posts = result.rows.map((row: any) => ({
    username: row.user_name,
    userId: row.user_id,
    userUrl: row.user_url,
    postId: row.post_id,
    title: row.post_title,
    content: row.post_content,
    imgUrl: row.post_url,
    postDate: row.post_date,
}));
---

<Layout title="🔐 Pagina privada || MySQL || FetchToMySQL">
    <header class="relative block w-full mb-8 sm:my-8 space-y-[.5lh] h-fit">
        <h2 class="text-3xl font-bold text-white text-balance sm:text-4xl">
            Bienvenido {firstName || ""}, Crea y comparte publicaciones entre
            desarrolladores.
        </h2>
        <p
            class="text-xl font-normal text-balance text-slate-200 dark:text-slate-300"
        >
            Es esta parte de la comunidad, es donde podrás compartir tus
            proyectos, ideas y experiencias.
        </p>
    </header>
    <div
        class="flex flex-col sm:flex-row gap-4 mb-4 sm:h-[780px] overflow-hidden sm:overflow-auto"
    >
        <!-- go to action. -->
        <FormPost
            client:visible
            userId={id}
            firstName={firstName || ""}
            imageUrl={imageUrl}
        >
            <Aviso
                mediaLinks={{
                    githubLink: import.meta.env.PUBLIC_GITHUB,
                    linkedinLink: import.meta.env.PUBLIC_LINKEDIN,
                    discordLink: import.meta.env.PUBLIC_DISCORD,
                }}
            />
        </FormPost>
        <!-- grid de publicaciones recientes-->
        <PostRecientes postsInitial={posts} />
    </div>
    <div>
        <MisProyectos />
    </div>
</Layout>
