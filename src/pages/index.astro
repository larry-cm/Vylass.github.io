---
import Layout from "@/layouts/Layout.astro";
import { SignedIn, SignedOut, SignInButton } from "@clerk/astro/components";
export const prerender = false;
---

<Layout title="Esta pagina es rica en búsqueda y publica || FetchToMySQL">
	<section class="block mt-24 h-fit">
		<h2 class="mb-16 text-4xl font-extrabold text-white text-balance">
			App para posts y comunicación entre desarrolladores ¡o al menos eso
			intentamos!
		</h2>
		<SignedOut>
			<p class="text-xl font-normal text-slate-200">
				Una vez que te hayas vinculado, tendrás acceso a la creación de
				publicaciones.
			</p>
			<SignInButton
				mode="modal"
				class="inline-block px-4 py-3 mt-4 font-medium transition-all bg-orange-500 rounded cursor-pointer hover:bg-orange-500/80"
			>
				Iniciar sesión
			</SignInButton>
		</SignedOut>

		<SignedIn>
			<div class="flex flex-col gap-5 sm:flex-row">
				<p class="py-3 text-xl font-normal text-slate-200 h-fit">
					Enhorabuena, ya estás vinculado.
				</p>
				<a
					href="/comunidad"
					class="block px-4 py-3 font-medium transition-colors bg-orange-500 rounded cursor-pointer h-fit hover:bg-orange-500/80 w-fit"
				>
					¡Crea tu primera publicación!
				</a>
			</div>
		</SignedIn>

		<article class="flex mt-24 ms-auto w-fit max-w-80">
			Por el momento no tengo imágenes pero va una demostración del chat de la
			comunidad.
		</article>
	</section>
</Layout>
